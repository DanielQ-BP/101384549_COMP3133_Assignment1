{
  "info": {
    "name": "Employee Management System - GraphQL API",
    "description": "Complete GraphQL API collection for Employee Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "User Operations",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Signup($input: SignupInput!) {\n  signup(input: $input) {\n    token\n    user {\n      _id\n      username\n      email\n      created_at\n    }\n    message\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"username\": \"johndoe\",\n    \"email\": \"john@example.com\",\n    \"password\": \"password123\"\n  }\n}"
              }
            },
            "url": {
              "raw": "http://localhost:4000/graphql",
              "protocol": "http",
              "host": ["localhost"],
              "port": "4000",
              "path": ["graphql"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Login($input: LoginInput!) {\n  login(input: $input) {\n    token\n    user {\n      _id\n      username\n      email\n    }\n    message\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"usernameOrEmail\": \"johndoe\",\n    \"password\": \"password123\"\n  }\n}"
              }
            },
            "url": {
              "raw": "http://localhost:4000/graphql",
              "protocol": "http",
              "host": ["localhost"],
              "port": "4000",
              "path": ["graphql"]
            }
          }
        }
      ]
    },
    {
      "name": "Employee Operations",
      "item": [
        {
          "name": "Add Employee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation AddEmployee($input: EmployeeInput!) {\n  addEmployee(input: $input) {\n    _id\n    first_name\n    last_name\n    email\n    gender\n    designation\n    salary\n    date_of_joining\n    department\n    employee_photo\n    created_at\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"first_name\": \"John\",\n    \"last_name\": \"Doe\",\n    \"email\": \"john.doe@company.com\",\n    \"gender\": \"Male\",\n    \"designation\": \"Software Engineer\",\n    \"salary\": 75000,\n    \"date_of_joining\": \"2024-01-15\",\n    \"department\": \"Engineering\",\n    \"employee_photo\": \"https://res.cloudinary.com/demo/image/upload/sample.jpg\"\n  }\n}"
              }
            },
            "url": {
              "raw": "http://localhost:4000/graphql",
              "protocol": "http",
              "host": ["localhost"],
              "port": "4000",
              "path": ["graphql"]
            }
          }
        },
        {
          "name": "Get All Employees",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query GetAllEmployees {\n  getAllEmployees {\n    _id\n    first_name\n    last_name\n    email\n    gender\n    designation\n    salary\n    date_of_joining\n    department\n    employee_photo\n  }\n}",
                "variables": ""
              }
            },
            "url": {
              "raw": "http://localhost:4000/graphql",
              "protocol": "http",
              "host": ["localhost"],
              "port": "4000",
              "path": ["graphql"]
            }
          }
        },
        {
          "name": "Get Employee by ID",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query GetEmployeeById($eid: ID!) {\n  getEmployeeById(eid: $eid) {\n    _id\n    first_name\n    last_name\n    email\n    gender\n    designation\n    salary\n    date_of_joining\n    department\n    employee_photo\n  }\n}",
                "variables": "{\n  \"eid\": \"YOUR_EMPLOYEE_ID_HERE\"\n}"
              }
            },
            "url": {
              "raw": "http://localhost:4000/graphql",
              "protocol": "http",
              "host": ["localhost"],
              "port": "4000",
              "path": ["graphql"]
            }
          }
        },
        {
          "name": "Update Employee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation UpdateEmployee($eid: ID!, $input: UpdateEmployeeInput!) {\n  updateEmployee(eid: $eid, input: $input) {\n    _id\n    first_name\n    last_name\n    email\n    designation\n    salary\n    department\n    updated_at\n  }\n}",
                "variables": "{\n  \"eid\": \"YOUR_EMPLOYEE_ID_HERE\",\n  \"input\": {\n    \"salary\": 85000,\n    \"designation\": \"Senior Software Engineer\"\n  }\n}"
              }
            },
            "url": {
              "raw": "http://localhost:4000/graphql",
              "protocol": "http",
              "host": ["localhost"],
              "port": "4000",
              "path": ["graphql"]
            }
          }
        },
        {
          "name": "Delete Employee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation DeleteEmployee($eid: ID!) {\n  deleteEmployee(eid: $eid) {\n    message\n    success\n  }\n}",
                "variables": "{\n  \"eid\": \"YOUR_EMPLOYEE_ID_HERE\"\n}"
              }
            },
            "url": {
              "raw": "http://localhost:4000/graphql",
              "protocol": "http",
              "host": ["localhost"],
              "port": "4000",
              "path": ["graphql"]
            }
          }
        },
        {
          "name": "Search by Designation or Department",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query SearchEmployee($designation: String, $department: String) {\n  searchEmployeeByDesignationOrDepartment(\n    designation: $designation\n    department: $department\n  ) {\n    _id\n    first_name\n    last_name\n    email\n    designation\n    department\n    salary\n  }\n}",
                "variables": "{\n  \"designation\": \"Software Engineer\",\n  \"department\": \"Engineering\"\n}"
              }
            },
            "url": {
              "raw": "http://localhost:4000/graphql",
              "protocol": "http",
              "host": ["localhost"],
              "port": "4000",
              "path": ["graphql"]
            }
          }
        }
      ]
    }
  ]
}
